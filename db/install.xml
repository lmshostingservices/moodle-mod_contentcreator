<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="mod/contentcreator/db" VERSION="2026082618" COMMENT="Content Creator tables">
  <TABLES>
    <TABLE NAME="contentcreator" COMMENT="Main activity table">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="course" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="name" TYPE="char" LENGTH="255" NOTNULL="true"/>
        <FIELD NAME="intro" TYPE="text" NOTNULL="false"/>
        <FIELD NAME="introformat" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="1"/>
        <FIELD NAME="manifestjson" TYPE="text" NOTNULL="false"/>
        <FIELD NAME="manifestversion" TYPE="char" LENGTH="20" NOTNULL="false"/>
        <FIELD NAME="completionviewallslides" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="completionallactivities" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" COMMENT="Require all decision challenge activities completed at 100%"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="course" TYPE="foreign" FIELDS="course" REFTABLE="course" REFFIELDS="id"/>
      </KEYS>
    </TABLE>
    <TABLE NAME="contentcreator_attempts" COMMENT="Student attempts and scores">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="contentcreatorid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="score" TYPE="number" LENGTH="10" DECIMALS="2" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="maxscore" TYPE="number" LENGTH="10" DECIMALS="2" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="completed" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="responses" TYPE="text" NOTNULL="false"/>
        <FIELD NAME="attemptdata" TYPE="text" NOTNULL="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="contentcreatorid" TYPE="foreign" FIELDS="contentcreatorid" REFTABLE="contentcreator" REFFIELDS="id"/>
        <KEY NAME="userid" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="user_activity" UNIQUE="true" FIELDS="contentcreatorid,userid"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="contentcreator_checklist" COMMENT="v9.78: Before You Start checklist completion tracking per user per topic">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="cmid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="topicid" TYPE="char" LENGTH="255" NOTNULL="false" COMMENT="Topic ID from manifest"/>
        <FIELD NAME="complete" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="userid" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
        <KEY NAME="cmid" TYPE="foreign" FIELDS="cmid" REFTABLE="course_modules" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="cmid_userid_topicid" UNIQUE="true" FIELDS="cmid,userid,topicid"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="contentcreator_progress" COMMENT="User progress tracking for v5.0.0 card-based player">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="cmid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="progress" TYPE="text" NOTNULL="false" COMMENT="JSON object with section completion states"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="userid" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
        <KEY NAME="cmid" TYPE="foreign" FIELDS="cmid" REFTABLE="course_modules" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="cmid_userid" UNIQUE="true" FIELDS="cmid,userid"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="contentcreator_evidence" COMMENT="Server-recorded evidence of learner progress. Written only by the plugin's own endpoints after the server has checked the claim against the stored manifest; never written from a client-supplied payload.">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="cmid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="sectionkey" TYPE="char" LENGTH="255" NOTNULL="true" COMMENT="Section id as it appears in the manifest"/>
        <FIELD NAME="viewed" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" COMMENT="1 once the server has confirmed this section exists and the learner opened it"/>
        <FIELD NAME="questiontotal" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="0" COMMENT="Questions the manifest holds for this section's challenge"/>
        <FIELD NAME="questionsanswered" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="questionscorrect" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="answermask" TYPE="text" NOTNULL="false" COMMENT="JSON map of question index to 1 or 0, so a re-answer replaces rather than double-counts"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="userid" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
        <KEY NAME="cmid" TYPE="foreign" FIELDS="cmid" REFTABLE="course_modules" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="cmid_userid_sectionkey" UNIQUE="true" FIELDS="cmid,userid,sectionkey"/>
        <INDEX NAME="cmid_userid" UNIQUE="false" FIELDS="cmid,userid"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
